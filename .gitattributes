# 规范形守门(test_canonical_tree)对换行符敏感:render 恒输出 LF,
# autocrlf=true 的 Windows 检出会把 md 改成 CRLF 破坏
# render(parse(x))==x —— 方言文件钉死 LF。只匹配 *.md:systems/ 以后
# 放截图/PDF 等二进制时不得被当文本改写换行(评审 N8)。
systems/**/*.md text eol=lf
# D5(2026-10-13):py 源码钉 LF —— release.py 等曾以 CRLF 入库,一次
# 修改带出上千行无效 diff;顺手覆盖全仓文本源码面(排除 md 方言文件
# 已单独钉死)。二进制不列。
*.py text eol=lf
*.ts text eol=lf
*.vue text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
# C5(2026-11-24):D5 清单外的文本扩展名补钉 LF。两个 .sh 曾以 CRLF 入库
# (CI/Linux bash 遇 \r 翻车);sql 实为文本(pg-init 容器脚本 + 迁移快照
# fixture),从 -text 转正统一 LF。dotfile 用全名匹配。
*.sh text eol=lf
*.css text eol=lf
*.html text eol=lf
*.php text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.ini text eol=lf
*.txt text eol=lf
*.csv text eol=lf
*.in text eol=lf
*.lock text eol=lf
*.example text eol=lf
*.npmrc text eol=lf
*.sql text eol=lf
.gitignore text eol=lf
.zcodeignore text eol=lf
.python-version text eol=lf
.gitattributes text eol=lf
.editorconfig text eol=lf
# 非源码资产不归一化(备份/数据/二进制)
*.bak -text
*.png -text
*.jpg -text
*.zip -text
*.ndjson -text
*.log -text
