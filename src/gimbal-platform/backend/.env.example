# 平台后端环境配置模板 — 复制为 .env 后按环境填写
# (.env 已移出版本控制,本机路径/密钥不入库;P0-04)

# 认证密钥(必填):缺失时服务拒绝启动(重启即丢全部会话与已存凭证密文)。
# 生成:python -c "import secrets;print(secrets.token_urlsafe(48))"
#       python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
# 与数据库备份同级保管(runbook-pg §备份)。
JWT_SECRET=
JWT_ALGO=HS256
ACCESS_TOKEN_EXPIRE_MIN=60
REFRESH_TOKEN_EXPIRE_DAYS=14
FERNET_KEY=
# 仅测试/一次性本地环境:允许以临时随机密钥启动(生产勿开)
# ALLOW_EPHEMERAL_SECRETS=1

# 自助注册:默认开放(新号 role=user);置 false 后仅空库首个注册者成为
# admin(引导),其后由 admin 在用户管理开号 —— 对外部署建议置 false
REGISTRATION_OPEN=true

# 数据库(必填,PG-only —— SQLite 方言已于 2026-10-14 退役:未设置或
# 非 postgresql URL 时启动在引擎构造期即 fail-fast,无本地回退库)。
# 本地起库:docker compose -f compose.pg.yml up -d
DATABASE_URL=postgresql+asyncpg://user:password@db-host:5432/gimbal
DATA_DIR=./data

# Gimbal 可执行文件(可选)。空值 = 平台回退用当前解释器 `python -m gimbal`
# (要求该解释器可导入 gimbal:pip install -e src/gimbal,或显式指向 gimbal.exe)
GIMBAL_BIN=

# 引擎插件注入(可选,空 = 引擎默认)
# GIMBAL_PLUGINS_DIR=
# GIMBAL_PLUGINS=
# GIMBAL_PLUGIN_CONFIGS=

# CORS(前端开发端口)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
