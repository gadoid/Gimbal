# 平台后端环境配置模板 — 复制为 .env 后按环境填写
# (.env 已移出版本控制,本机路径/密钥不入库;P0-04)

# 认证(必填,生产环境务必显式配置;留空时 dev 启动会自动生成)
JWT_SECRET=
JWT_ALGO=HS256
ACCESS_TOKEN_EXPIRE_MIN=60
REFRESH_TOKEN_EXPIRE_DAYS=14
FERNET_KEY=

# 数据库。开发默认远端 PG;未设置时回退 backend/data/app.db(SQLite)
DATABASE_URL=postgresql+asyncpg://user:password@db-host:5432/gimbal
DATA_DIR=./data

# Gimbal 可执行文件(可选)。空值 = 平台回退用当前解释器 `python -m gimbal`
# (要求该解释器可导入 gimbal:pip install -e src/gimbal,或显式指向 gimbal.exe)
GIMBAL_BIN=

# 引擎插件注入(可选,空 = 引擎默认)
# GIMBAL_PLUGINS_DIR=
# GIMBAL_PLUGINS=
# GIMBAL_PLUGIN_CONFIGS=

# CORS(前端开发端口)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
