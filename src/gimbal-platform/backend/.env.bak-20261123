# Gimbal 平台后端 — 远端服务器部署配置 (feat/plate-s1, 2026-10-15)
# 密钥为固定值:重启不会轮换(丢失=全部会话失效+凭证密文不可解,与 DB 备份同级保管)

JWT_SECRET=q-Gu53ZY1iXm9q3nMqSrKjvea85Un9S4BmiJFxZyJ1LG5xprg0rEPaZxmpgKsIfX
JWT_ALGO=HS256
ACCESS_TOKEN_EXPIRE_MIN=60
REFRESH_TOKEN_EXPIRE_DAYS=14
FERNET_KEY=fezo83TdvQuUPO0NSCv6JKfwpk7JI9DPSG01M1cM3bk=

# 自助注册开放(新号 role=user)
REGISTRATION_OPEN=true

# 系统原生 PostgreSQL 16(gimbal 库)
DATABASE_URL=postgresql+asyncpg://gimbal:gimbal@127.0.0.1:5432/gimbal
DATA_DIR=./data

# plate 服务(同机)
PLATE_BASE_URL=http://127.0.0.1:8765

# 前端经 nginx(8188) 同源反代,不依赖 CORS;此处仍显式放开常用来源
CORS_ORIGINS=http://192.168.22.106:8188,http://127.0.0.1:5173,http://localhost:5173

# 决策 1 引用即登记(阶段 0):audit 态保存/导入闸 —— 生产先跑此态拿真实数据
