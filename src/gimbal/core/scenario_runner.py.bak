"""ScenarioRunner：驱动单个 Scenario 从头到尾执行的核心引擎。

职责链：
  ScenarioRunner
    └── 遍历 steps
          └── StepRunner（每个 Step 一个实例）
                ├── StepStateMachine（状态流转）
                └── StrategyDispatcher（分阶段执行策略）

设计原则：
  - ScenarioRunner 不关心"策略怎么执行"，只关心"step 顺序和 scenario 结果汇总"
  - StepRunner 不关心"scenario 结果"，只关心"把一个 step 跑完"
  - 状态机不关心任何业务，只维护状态合法性
"""
from __future__ import annotations

import logging
from dataclasses import dataclass, field
from datetime import datetime
from typing import Optional

from gimbal.context.manager import ContextManager
from gimbal.context.scenario import ScenarioContext
from gimbal.context.step import StepContext, StepStatus
from gimbal.context.suite import SuiteContext
from gimbal.context.views import StepContextAdapter
from gimbal.schema.scenario import Scenario
from gimbal.schema.step import Step,StepUnion
from gimbal.schema.strategy import StrategyPhase, FailurePolicy
from gimbal.statemachine.engine import StepStateMachine
from gimbal.statemachine.states import StepState
from gimbal.strategy.dispatcher import StrategyDispatcher
from gimbal.strategy.executor_base import StrategyStatus, PhaseResult

logger = logging.getLogger(__name__)


# ─────────────────────────────────────────────────────────────────────────────
# 内部 _CallSpec：CallExecutor 需要但不属于 schema
# ─────────────────────────────────────────────────────────────────────────────

@dataclass
class _CallSpec:
    """由 ScenarioRunner 在 CALLING 阶段合成，传给 CallExecutor。"""
    kind: str = "_call"
    method: str = "GET"
    url: str = ""
    headers: dict = field(default_factory=dict)
    body: dict = field(default_factory=dict)
    timeout: float = 30.0
    # StrategyBase 必需字段
    name: Optional[str] = "http_call"
    phase: Optional[str] = None
    order: int = 0
    enabled: bool = True
    onFailure: str = "abort"
    tags: list = field(default_factory=list)


# ─────────────────────────────────────────────────────────────────────────────
# ScenarioResult
# ─────────────────────────────────────────────────────────────────────────────

@dataclass
class StepRunResult:
    step_id: str
    status: str
    phase_results: list[PhaseResult] = field(default_factory=list)
    error: Optional[str] = None
    duration_ms: float = 0.0



@dataclass
class ScenarioRunResult:
    scenario_id: str
    status: str            # passed / failed / error
    step_results: list[StepRunResult] = field(default_factory=list)
    started_at: Optional[datetime] = None
    ended_at: Optional[datetime] = None

    @property
    def passed(self) -> bool:
        return self.status == "passed"

    @property
    def duration_ms(self) -> float:
        if self.started_at and self.ended_at:
            return (self.ended_at - self.started_at).total_seconds() * 1000
        return 0.0


# ─────────────────────────────────────────────────────────────────────────────
# StepRunner
# ─────────────────────────────────────────────────────────────────────────────

class StepRunner:
    """驱动单个 Step 完成全部阶段。

    执行顺序（对应状态机状态）：
      PENDING → BEFORE_REQUEST → CALLING → AFTER_REQUEST → VERIFYING → TEARDOWN → PASSED/FAILED
    """

    # 每个阶段状态 → StrategyPhase 枚举值 的映射
    _PHASE_MAP: dict[StepState, str] = {
        StepState.BEFORE_REQUEST: StrategyPhase.BEFORE_REQUEST,
        StepState.AFTER_REQUEST: StrategyPhase.AFTER_REQUEST,
        StepState.VERIFYING: StrategyPhase.VERIFYING,
        StepState.TEARDOWN: StrategyPhase.TEARDOWN,
    }

    def __init__(
        self,
        dispatcher: StrategyDispatcher,
        ctx_manager: ContextManager,
        service_base_url: str = "",
    ) -> None:
        self._dispatcher = dispatcher
        self._ctx_manager = ctx_manager
        self._service_base_url = service_base_url

    def run(
        self,
        step_schema: StepUnion, 
        scenario_ctx: ScenarioContext,
        step_index: int,
    ) -> StepRunResult:
        """执行一个 Step，返回结果。"""

        step_id = f"step-{step_index:03d}"
        step_name = step_id

        # 1. 创建 StepContext
        step_ctx = self._ctx_manager.derive_step_context(
            scenario_ctx,
            step_id=step_id,
            step_name=step_name,
            strategy_kind="multi",
            strategy_spec=step_schema.model_dump(),
            resolved_vars={},
        )

        # 2. 初始化状态机
        sm = StepStateMachine(
            step_id=step_id,
            on_transition=lambda f, t, r: logger.debug(
                "[Step %s] %s → %s  (%s)", step_id, f.value, t.value, r
            ),
        )

        phase_results: list[PhaseResult] = []
        view = StepContextAdapter(step_ctx)
        t_start = datetime.utcnow()

        try:
            # ── BEFORE_REQUEST ──────────────────────────────────────────────
            sm.advance(StepState.BEFORE_REQUEST, reason="start")
            print("进入预请求阶段")
            pr = self._run_phase(
                StrategyPhase.BEFORE_REQUEST, step_schema.strategy, view
            )
            phase_results.append(pr)
            if pr.hard_failed:
                sm.advance(StepState.TEARDOWN, reason="before_request hard-failed")
                self._run_teardown(step_schema, view, sm, phase_results)
                return self._finalize(step_ctx, sm, step_id, phase_results, t_start, "failed")

            # ── CALLING ──────────────────────────────────────────────────────
            sm.advance(StepState.CALLING, reason="before_request done")
            call_result = self._do_http_call(step_schema, view, scenario_ctx)
            phase_results.append(PhaseResult(phase="calling", results=[call_result]))

            if call_result.failed:
                sm.advance(StepState.TEARDOWN, reason="http call failed")
                self._run_teardown(step_schema, view, sm, phase_results)
                return self._finalize(step_ctx, sm, step_id, phase_results, t_start, "failed")

            # ── AFTER_REQUEST ────────────────────────────────────────────────
            sm.advance(StepState.AFTER_REQUEST, reason="call done")
            pr = self._run_phase(
                StrategyPhase.AFTER_REQUEST, step_schema.strategy, view
            )
            phase_results.append(pr)
            if pr.hard_failed:
                sm.advance(StepState.TEARDOWN, reason="after_request hard-failed")
                self._run_teardown(step_schema, view, sm, phase_results)
                return self._finalize(step_ctx, sm, step_id, phase_results, t_start, "failed")

            # ── VERIFYING ────────────────────────────────────────────────────
            sm.advance(StepState.VERIFYING, reason="after_request done")
            pr = self._run_phase(
                StrategyPhase.VERIFYING, step_schema.strategy, view
            )
            phase_results.append(pr)

            # 有 teardown 策略则进入 TEARDOWN 阶段，否则直接终态
            has_teardown = any(
                getattr(s, "phase", None) == StrategyPhase.TEARDOWN
                for s in step_schema.strategy
            )
            if has_teardown:
                sm.advance(StepState.TEARDOWN, reason="verifying done, running teardown")
                self._run_teardown(step_schema, view, sm, phase_results)
            else:
                terminal = StepState.PASSED if pr.all_passed else StepState.FAILED
                sm.advance(terminal, reason="verifying done")

        except Exception as exc:
            logger.exception("[Step %s] Unexpected error", step_id)
            sm.try_advance(StepState.ERROR, reason=str(exc))
            return StepRunResult(
                step_id=step_id,
                status="error",
                phase_results=phase_results,
                error=repr(exc),
                duration_ms=(datetime.utcnow() - t_start).total_seconds() * 1000,
            )

        final_status = sm.state.value
        return self._finalize(step_ctx, sm, step_id, phase_results, t_start, final_status)

    # ── 内部辅助 ─────────────────────────────────────────────────────────────

    def _run_phase(
        self,
        phase: str,
        strategies,
        view: StepContextAdapter,
    ) -> PhaseResult:
        results = self._dispatcher.dispatch_phase(phase, strategies, view)
        return PhaseResult(phase=phase, results=results)

    def _do_http_call(
        self,
        step_schema: Step,
        view: StepContextAdapter,
        scenario_ctx: ScenarioContext,
    ):
        """合成 _CallSpec 并交给 CallExecutor 执行。"""
        from gimbal.strategy.executor_base import StrategyResult, StrategyStatus

        api = step_schema.api
        # api 可能是 ApiRef，此时应已在预处理阶段展开；这里仅处理 Api
        if not hasattr(api, "service"):
            return StrategyResult(
                status=StrategyStatus.ERROR,
                message="api is a ref that was not resolved",
            )

        # 从 scenario config 中读取服务基地址
        service_url = self._service_base_url or f"http://{api.service}"

        # 读取请求体（request 同理，可能是 RequestRef）
        request = step_schema.request
        body = getattr(request, "body", {}) or {}

        # 写入 request_body 到 context 供 BEFORE_REQUEST 阶段的 Assign 使用
        from gimbal.context.base import ContextLayer
        view.promote_variable(
            "request_body", body,
            to=ContextLayer.SCENARIO,
            allow_overwrite=True,
        )

        call_spec = _CallSpec(
            method=api.method,
            url=f"{service_url.rstrip('/')}{api.path}",
            headers=api.headers or {},
            body=body,
            timeout=api.timeout,
        )

        return self._dispatcher.dispatch(call_spec, view)

    def _run_teardown(
        self,
        step_schema: Step,
        view: StepContextAdapter,
        sm: StepStateMachine,
        phase_results: list,
    ) -> None:
        pr = self._run_phase(StrategyPhase.TEARDOWN, step_schema.strategy, view)
        phase_results.append(pr)
        # teardown 结果决定最终状态（teardown 失败也是 failed）
        terminal = StepState.FAILED if pr.any_failed else StepState.PASSED
        # 如果之前 phase 已经是 failed，保持 failed
        sm.try_advance(terminal, reason="teardown done")

    def _finalize(
        self,
        step_ctx: StepContext,
        sm: StepStateMachine,
        step_id: str,
        phase_results: list[PhaseResult],
        t_start: datetime,
        status: str,
    ) -> StepRunResult:
        step_status = StepStatus(status) if status in StepStatus._value2member_map_ else StepStatus.ERROR
        self._ctx_manager.finalize_step(step_ctx, step_status)
        return StepRunResult(
            step_id=step_id,
            status=status,
            phase_results=phase_results,
            duration_ms=(datetime.utcnow() - t_start).total_seconds() * 1000,
        )


# ─────────────────────────────────────────────────────────────────────────────
# ScenarioRunner
# ─────────────────────────────────────────────────────────────────────────────

class ScenarioRunner:
    """驱动整个 Scenario 执行。

    - 在 SuiteContext 下 derive ScenarioContext
    - 顺序执行所有 steps（并发由上层 Scheduler 处理）
    - 汇总结果，finalize ScenarioContext
    """

    def __init__(
        self,
        dispatcher: StrategyDispatcher,
        ctx_manager: ContextManager,
    ) -> None:
        self._dispatcher = dispatcher
        self._ctx_manager = ctx_manager

    def run(
        self,
        scenario_schema: Scenario,
        suite_ctx: SuiteContext,
    ) -> ScenarioRunResult:
        started_at = datetime.utcnow()
        sid = scenario_schema.scenarioId

        # 1. 创建 ScenarioContext
        scenario_ctx = self._ctx_manager.derive_scenario_context(
            suite_ctx,
            scenario_id=sid,
            scenario_name=scenario_schema.meta.name,
            description=scenario_schema.meta.description,
        )

        # 2. 注入 serviceDict / authDict 到 scenario channels
        self._inject_config(scenario_schema, scenario_ctx)

        # 3. 执行前置 setup（预留，Setup schema 目前是占位）
        # TODO: _run_setup(scenario_schema.config.setup, scenario_ctx)

        step_results: list[StepRunResult] = []
        overall_status = "passed"

        # 4. 逐步执行
        step_runner = StepRunner(
            dispatcher=self._dispatcher,
            ctx_manager=self._ctx_manager,
            service_base_url=self._pick_base_url(scenario_schema),
        )

        for idx, step_union in enumerate(scenario_schema.steps):
            # StepUnion 可能是 Step 或 StepRef，Ref 应在预处理阶段展开
            if not hasattr(step_union, "api"):
                logger.warning("[Scenario %s] step[%d] is a ref, skipping", sid, idx)
                continue

            result = step_runner.run(step_union, scenario_ctx, idx+1)
            step_results.append(result)

            if result.status in ("failed", "error"):
                overall_status = result.status
                # fail_fast：如有需要可从 scenario config 读取
                break

        # 5. 执行后置 teardown（预留）
        # TODO: _run_teardown(scenario_schema.config.teardown, scenario_ctx)

        # 6. finalize
        self._ctx_manager.finalize_scenario(scenario_ctx, overall_status)

        ended_at = datetime.utcnow()
        return ScenarioRunResult(
            scenario_id=sid,
            status=overall_status,
            step_results=step_results,
            started_at=started_at,
            ended_at=ended_at,
        )

    def _inject_config(self, schema: Scenario, ctx: ScenarioContext) -> None:
        """将 config.serviceDict / authDict 注入到 scenario channels。"""
        from gimbal.context.base import ContextLayer

        cfg = schema.config
        service_dict = getattr(cfg, "serviceDict", None) or {}
        auth_dict = getattr(cfg, "authDict", None) or {}

        # 用 object.__setattr__ 绕过 seal——context 此时尚未 seal
        # 更好的做法是提供 inject_initial_vars 接口，这里简化
        for k, v in service_dict.items():
            ctx.channels.promote_from(
                key=f"service.{k}",
                value=v,
                from_layer=ContextLayer.STEP,     # 用框架注入身份
                by_step_id="__framework__",
            )
        for k, v in auth_dict.items():
            ctx.channels.promote_from(
                key=f"auth.{k}",
                value=v,
                from_layer=ContextLayer.STEP,
                by_step_id="__framework__",
            )

    def _pick_base_url(self, schema: Scenario) -> str:
        """从 serviceDict 选出第一个服务地址作为默认基地址。"""
        cfg = schema.config
        sd = getattr(cfg, "serviceDict", None) or {}
        return next(iter(sd.values()), "")