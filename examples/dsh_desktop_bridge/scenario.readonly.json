      "kind": "step",
      "description": "鉴权：缺少 Authorization → 401",
      "api": {
        "kind": "api",
        "service": "bridge",
        "method": "GET",
        "path": "/v1/sessions",
        "headers": {},
        "timeout": 20
      },
      "request": {
        "kind": "request",
        "body": {}
      },
      "strategy": [
        {
          "kind": "assertion",
          "target": "$.response_status",
          "operator": "eq",
          "expected": 401,
          "message": "无 token 必须 401"
        },
        {
          "kind": "assertion",
          "target": "$.response_body.error",
          "operator": "eq",
          "expected": "unauthorized"
        }
      ]
    },
    {
      "kind": "step",
      "description": "鉴权：错误 token → 401",
      "api": {
        "kind": "api",
        "service": "bridge",
        "method": "GET",
        "path": "/v1/sessions",
        "headers": {
          "Authorization": "Bearer not-the-token"
        },
        "timeout": 20
      },
      "request": {
        "kind": "request",
        "body": {}
      },
      "strategy": [
        {
          "kind": "assertion",
          "target": "$.response_status",
          "operator": "eq",
          "expected": 401,
