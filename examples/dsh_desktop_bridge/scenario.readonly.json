{
  "kind": "scenario",
  "scenarioId": "sc-dsh-bridge-readonly",
  "meta": {
    "name": "dsh-desktop-bridge 只读与负向接口测试",
    "description": "访问控制 / 路由 / 入参校验；除 list 与 events 外不触达 sessionController，对真实桌面端无副作用",
    "module": "dsh-desktop-bridge",
    "priority": 1,
    "author": "gimbal",
    "owner": "gimbal",
    "tags": [
      "dsh",
      "bridge",
      "readonly",
      "security"
    ],
    "version": "1.0.0",
    "createTime": "2026-10-09T00:00:00",
    "expire": false,
    "requirementRef": []
  },
  "config": {
    "setup": [],
    "teardown": [],
    "services": {
      "bridge": "http://127.0.0.1:0"
    },
    "users": {},
    "vars": {
      "token": "REPLACE_ME",
      "port": "0",
      "session_id": "session-00000000-0000-0000-0000-000000000000",
      "kb": {
        "kind": "random_str",
        "length": 1024,
        "charset": "alnum"
      }
    },
    "timePolicy": {
      "kind": "record"
    },
    "retry": null
  },
  "resource": {},
