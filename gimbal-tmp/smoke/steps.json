{
  "steps": [
    {
      "kind": "step",
      "description": "查询[放款状态]=已放款",
      "api": {
        "kind": "api",
        "service": "yhr-test-service",
        "method": "GET",
        "path": "/newshopadmin-tidb/SyncLogorder/ajaxGetList.html",
        "headers": {
          "Cookie": "${auth.yhxjsx.token}",
          "Content-Type": "application/x-www-form-urlencoded"
        },
        "timeout": 30
      },
      "request": {
        "kind": "request",
        "body": {
          "page": "1",
          "size": "15",
          "wd": "",
          "search_company": "",
          "order_terminated_shutout_status": "1",
          "bulk_query_type": "1",
          "bulk_query": "0",
          "financing_status": "",
          "sale": "",
          "ship_company": "",
          "search_time[charge_pay_date][0]": "",
          "search_time[charge_pay_date][1]": "",
          "release_status": "1"
        }
      },
      "strategy": [
        {
          "kind": "assertion",
          "name": "assert_http_status_eq_200",
          "phase": "verifying",
          "order": 0,
          "enabled": true,
          "onFailure": "abort",
          "target": "$.response_status",
          "operator": "eq",
          "expected": 200,
          "message": "查询[放款状态]=已放款 应返回200",
          "soft": false
        },
        {
          "kind": "assertion",
          "name": "assert_count_shrinks",
          "phase": "verifying",
          "order": 1,
          "enabled": true,
          "onFailure": "abort",
          "target": "$.response_body.count",
          "operator": "<=",
          "expected": 540,
          "message": "①count_shrinks: 相等意味着过滤参数被后端忽略",
          "soft": false
        },
        {
          "kind": "assertion",
          "name": "assert_anchor_present",
          "phase": "verifying",
          "order": 2,
          "enabled": true,
          "onFailure": "abort",
          "target": "$.response_body.list[*].id",
          "operator": "contains",
          "expected": "ROW-1",
          "message": "②anchor_present: 已知记录必须可查到",
          "soft": false
        },
        {
          "kind": "assertion",
          "name": "assert_first_page_rows_match",
          "phase": "verifying",
          "order": 3,
          "enabled": true,
          "onFailure": "abort",
          "target": "$.response_body.list",
          "operator": "row_match",
          "expected_canon": "已放款",
          "expected_display": "已放款",
          "response_field": "release_status",
          "response_fields": [],
          "page_size": 5,
          "category": "ENUM",
          "message": "③rows_match: 首页每行满足条件(canonicalize 后)",
          "soft": false
        },
        {
          "kind": "extract",
          "name": "extract_response_body",
          "phase": "after_request",
          "order": 0,
          "enabled": true,
          "onFailure": "abort",
          "expression": "$.response_body",
          "target": "response_body",
          "required": true,
          "default": null,
          "scope": "scenario"
        }
      ]
    },
